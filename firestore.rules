// Apply/merge these into the Cloud Firestore Rules of the birthday Firebase project.
// Replace REPLACE_WITH_RECIPIENT_FIREBASE_AUTH_UID with the intended
// recipient's Firebase Authentication UID before publishing.
//
// The passcode 2705520 is only a UI gate. Firestore reads are controlled by
// authenticated identity, not the public code in this repository.
//
// NOTE: If you already have rules for other Firestore collections, MERGE
// this match /fanLetters/{letterId} block into your existing rules,
// rather than replacing unrelated collections' rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fanLetters/{letterId} {
      // Visitors may submit once as an anonymous Firebase Auth identity,
      // with validated fields. They cannot read even their own submission.
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['name', 'message', 'senderUid'])
        && request.resource.data.keys().hasAll(['name', 'message', 'senderUid'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;

      // Only one explicitly approved Firebase Authentication account can read
      // any of the sealed envelopes. Replace the placeholder UID in Firebase.
      allow get, list: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_RECIPIENT_FIREBASE_AUTH_UID';

      // No client-side editing or deleting other people's messages.
      allow update, delete: if false;
    }

    // This fallback is safe for a NEW, dedicated database.
    // In an existing Firebase project, merge the block above into your
    // current rules; do not erase rules of unrelated applications.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
